UnderlabConfig(
    hosts: [
        DeployHostConfig(
            host: Pi,
            ssh_host: "pi.djan.org",
            ssh_user: "djanatyn",
            staging_directory: "/var/lib/underlab/staging",
        ),
        DeployHostConfig(
            host: Synology,
